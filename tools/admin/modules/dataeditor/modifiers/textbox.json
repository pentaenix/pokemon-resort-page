{
  "title": "Overworld Text Box",
  "description": "Real config/gameplay/world3d/textbox.json: interaction text-box visibility, skin selection, sprite-sheet slicing, padding, and future text defaults.",
  "tags": [
    "verified",
    "overworld",
    "ui",
    "textbox"
  ],
  "groups": [
    {
      "id": "behavior",
      "label": "Behavior",
      "order": 5
    },
    {
      "id": "skin",
      "label": "Skin selection",
      "order": 10
    },
    {
      "id": "assets",
      "label": "Assets",
      "order": 15
    },
    {
      "id": "layout",
      "label": "Viewport padding",
      "order": 20
    },
    {
      "id": "slicing",
      "label": "Sprite-sheet slicing",
      "order": 30
    },
    {
      "id": "futureText",
      "label": "Dialogue text",
      "order": 40
    },
    {
      "id": "advanceMarker",
      "label": "Dialogue advance marker",
      "order": 45
    }
  ],
  "fields": {
    "textbox.advanceSound.enabled": {"label": "Message advance sound", "widget": "checkbox", "group": "behavior"},
    "textbox.advanceSound.path": {"label": "Message sound file", "widget": "asset", "group": "behavior"},
    "textbox.advanceSound.volume": {"label": "Message sound volume", "widget": "slider", "min": 0, "max": 1, "step": 0.01, "group": "behavior"},
    "textbox.advanceMarker.enabled": {"label": "Show advance marker", "widget": "checkbox", "group": "advanceMarker"},
    "textbox.advanceMarker.path": {"label": "Marker sprite sheet", "widget": "asset", "group": "advanceMarker"},
    "textbox.advanceMarker.frameSeconds": {"label": "Animation frame seconds", "widget": "number", "min": 0.01, "step": 0.01, "group": "advanceMarker"},
    "textbox.advanceMarker.rightInsetPx": {"label": "Right inset", "widget": "number", "min": 0, "step": 1, "group": "advanceMarker"},
    "textbox.advanceMarker.bottomInsetPx": {"label": "Bottom inset", "widget": "number", "min": 0, "step": 1, "group": "advanceMarker"},
    "textbox.advanceMarker.frameWidthPx": {"label": "Frame width", "widget": "number", "min": 1, "max": 128, "step": 1, "group": "advanceMarker", "advanced": true},
    "textbox.advanceMarker.frameHeightPx": {"label": "Frame height", "widget": "number", "min": 1, "max": 128, "step": 1, "group": "advanceMarker", "advanced": true},
    "textbox.advanceMarker.frameCount": {"label": "Frame count", "widget": "number", "min": 1, "max": 32, "step": 1, "group": "advanceMarker", "advanced": true},
    "textbox.text.bottomInsetPx": {"label": "Text bottom inset", "widget": "number", "min": 0, "step": 1, "unit": "px", "group": "layout"},
    "textbox.text.lineGapPx": {"label": "Dialogue line spacing", "widget": "number", "min": 0, "max": 24, "step": 1, "unit": "px", "group": "layout", "description": "Extra space between the two vertically centered dialogue rows."},
    "textbox.visibleMode": {
      "label": "Visible Mode",
      "widget": "select",
      "options": [
        "enabled",
        "disabled"
      ],
      "group": "behavior",
      "order": 1
    },
    "textbox.selectedSkinIndex": {
      "label": "Selected Skin Index",
      "description": "0-12. Visual order runs down the left column first, then down the right column. The bottom-right empty cell is ignored.",
      "widget": "number",
      "min": 0,
      "max": 12,
      "step": 1,
      "group": "skin",
      "order": 1
    },
    "textbox.validSkinCount": {
      "label": "Valid Skin Count",
      "description": "Keep at 13 so the 14th bottom-right cell remains unavailable.",
      "widget": "number",
      "min": 1,
      "max": 13,
      "step": 1,
      "group": "skin",
      "advanced": true,
      "order": 2
    },
    "textbox.spriteSheetPath": {
      "label": "Sprite Sheet Path",
      "widget": "asset",
      "group": "assets",
      "order": 1
    },
    "textbox.padding.bottomPx": {
      "label": "Bottom Padding",
      "widget": "number",
      "min": 0,
      "step": 1,
      "unit": "px",
      "group": "layout",
      "order": 1
    },
    "textbox.padding.sidePx": {
      "label": "Side Padding",
      "widget": "number",
      "min": 0,
      "step": 1,
      "unit": "px",
      "group": "layout",
      "order": 2
    },
    "textbox.sourceSheet.cellWidthPx": {
      "label": "Source Cell Width",
      "widget": "number",
      "min": 1,
      "step": 1,
      "unit": "px",
      "group": "slicing",
      "advanced": true,
      "order": 1
    },
    "textbox.sourceSheet.cellHeightPx": {
      "label": "Source Cell Height",
      "widget": "number",
      "min": 1,
      "step": 1,
      "unit": "px",
      "group": "slicing",
      "advanced": true,
      "order": 2
    },
    "textbox.sourceSheet.columns": {
      "label": "Sheet Columns",
      "widget": "number",
      "min": 1,
      "step": 1,
      "group": "slicing",
      "advanced": true,
      "order": 3
    },
    "textbox.horizontalStretch.stripWidthPx": {
      "label": "Stretch Strip Width",
      "description": "Only this central strip stretches horizontally; stylized sides stay pixel-perfect.",
      "widget": "number",
      "min": 1,
      "step": 1,
      "unit": "px",
      "group": "slicing",
      "order": 4
    },
    "textbox.horizontalStretch.sourceCenterXPx": {
      "label": "Stretch Strip Center X",
      "description": "Source X center inside each 256 px skin cell.",
      "widget": "number",
      "min": 0,
      "step": 1,
      "unit": "px",
      "group": "slicing",
      "order": 5
    },
    "textbox.text.fontPath": {
      "label": "Dialogue Font Path",
      "widget": "asset",
      "group": "futureText",
      "order": 1
    },
    "textbox.text.fontSizePx": {
      "label": "Dialogue Font Size",
      "widget": "number",
      "min": 1,
      "step": 1,
      "unit": "px",
      "group": "futureText",
      "order": 2
    }
  },
  "matches": [
    "textbox.json",
    "**/textbox.json"
  ]
}
