{
  "title": "Attend Audio Defaults",
  "description": "Shared TEST ATTEND audio timing. Cry assets follow the active Pokemon species at runtime.",
  "matches": [
    "gameplay/pokemon_attend/audio/*.json"
  ],
  "tags": [
    "attend",
    "audio"
  ],
  "groups": [
    {"id":"music","label":"Care-scene music","order":0},
    {
      "id": "cries",
      "label": "Pokemon cries",
      "description": "Timing for Pokemon cry playback during Attend interactions.",
      "order": 1
    }
  ],
  "fields": {
    "audio.music.massagePath":{"label":"Spa looping music asset","group":"music"},
    "audio.music.massageVolume":{"label":"Spa music relative volume","group":"music","min":0,"max":1,"step":0.025,"description":"Relative gain before the shared music channel/master controls. Follows the white transition fade."},
    "audio.playSoundCooldownSeconds": {"label":"Toy contact/impact cooldown","group":"cries","min":0.05,"max":5,"step":0.05},
    "audio.playSounds.*.air": {"label":"Dry play event sound (empty disables)","group":"cries"},
    "audio.playSounds.*.underwater": {"label":"Underwater play event sound (empty disables)","group":"cries"},
    "audio.materialSounds.*.air": {"label":"Dry material contact/impact sound","group":"cries"},
    "audio.materialSounds.*.underwater": {"label":"Underwater material contact/impact sound","group":"cries"},
    "audio.bubblePopSfx": { "label": "Bubble actor-pop sound (empty disables)", "group": "cries" },
    "audio.balloonPopSfx": { "label": "Balloon actor-pop sound (empty disables)", "group": "cries" },
    "audio.playPopCooldownSeconds": { "label": "Minimum time between repeated pop sounds", "group": "cries", "min": 0.05, "max": 5, "step": 0.05, "unit": " seconds" },
    "audio.petHappyCryDelaySeconds": {
      "label": "Pet-happy cry delay",
      "group": "cries",
      "order": 1,
      "step": 0.01,
      "unit": " seconds",
      "min": 0
    }
  }
}
