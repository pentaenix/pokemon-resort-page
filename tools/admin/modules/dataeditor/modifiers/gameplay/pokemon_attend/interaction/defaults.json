{
  "title": "Attend Interaction Defaults",
  "description": "Shared Attend camera and pointer-look defaults. UI controls live in pokemon_attend/ui.",
  "matches": [
    "gameplay/pokemon_attend/interaction/*.json"
  ],
  "tags": [
    "attend",
    "interaction",
    "camera"
  ],
  "groups": [
    {
      "id": "camera",
      "label": "Camera framing",
      "description": "Start with Distance Multiplier. Auto-focus computes the actual camera position.",
      "order": 1
    },
    {
      "id": "look",
      "label": "Pointer look",
      "order": 20
    },
    {
      "id": "cameraAdvanced",
      "label": "Advanced camera",
      "description": "Manual fallback, lens clipping, and Q freecam setup.",
      "order": 90,
      "collapsedDefault": true
    }
  ],
  "fields": {
    "camera.autoFocus": {
      "label": "Auto-focus camera",
      "widget": "checkbox",
      "group": "camera",
      "order": 1
    },
    "camera.fullBodyFraming.pokemonScreenHeight": {
      "label": "Full-body screen height",
      "widget": "slider",
      "min": 0.15,
      "max": 0.95,
      "step": 0.01,
      "group": "camera",
      "order": 2
    },
    "camera.fullBodyFraming.distanceMultiplier": {
      "label": "Full-body distance multiplier",
      "description": "Lower moves the camera closer; higher moves it farther.",
      "widget": "slider",
      "min": 0.35,
      "max": 2.5,
      "step": 0.01,
      "group": "camera",
      "order": 3
    },
    "camera.faceFraming.faceScreenHeight": {
      "label": "Face-view screen height",
      "widget": "slider",
      "min": 0.15,
      "max": 0.98,
      "step": 0.01,
      "group": "camera",
      "order": 20
    },
    "camera.faceFraming.distanceMultiplier": {
      "label": "Face-view distance multiplier",
      "widget": "slider",
      "min": 0.15,
      "max": 2.5,
      "step": 0.01,
      "group": "camera",
      "order": 21
    }
  },
  "patterns": {
    "viewportLook.*": {
      "group": "look"
    },
    "camera.fullBodyFraming.*": {
      "group": "camera"
    },
    "camera.faceFraming.*": {
      "group": "camera"
    },
    "camera.advanced.*": {
      "group": "cameraAdvanced",
      "advanced": true
    },
    "camera.advanced.*.*": {
      "group": "cameraAdvanced",
      "advanced": true
    },
    "camera.advanced.*.*.*": {
      "group": "cameraAdvanced",
      "advanced": true
    }
  }
}
