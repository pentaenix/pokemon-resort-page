{
  "title": "Attend Interaction Defaults",
  "description": "Shared Attend camera and pointer-look defaults. UI controls live in pokemon_attend/ui.",
  "matches": [
    "gameplay/pokemon_attend/interaction/*.json"
  ],
  "tags": [
    "attend",
    "interaction",
    "camera"
  ],
  "groups": [
    {"id":"wellbeing","label":"Enjoyment and fullness","order":25},
    {
      "id": "camera",
      "label": "Camera framing",
      "description": "Start with Distance Multiplier. Auto-focus computes the actual camera position.",
      "order": 1
    },
    {
      "id": "look",
      "label": "Pointer look",
      "order": 20
    },
    {
      "id": "toys",
      "label": "Toys and play camera",
      "description": "Pickup, flick throws, inner-map bounds, food, happy effects and adaptive camera framing.",
      "order": 30
    },
    {
      "id": "cameraAdvanced",
      "label": "Advanced camera",
      "description": "Manual fallback, lens clipping, and Q freecam setup.",
      "order": 90,
      "collapsedDefault": true
    },
    {
      "id": "toyMedia", "label": "Underwater toy response", "order": 35,
      "description": "Resolved once per scene. Buoyancy 1 hovers, above 1 rises, below 1 sinks. Original toy mass and size remain unchanged."
    }
  ],
  "patterns": {
    "toyCamera.*": {"group": "toys"},
    "toyCamera.distanceMultipliers.*": {"widget": "number", "min": 1, "max": 10, "step": 0.05},
    "toyBall.*": {"group": "toys"},
    "toyBall.profiles.*.radius": {"label": "World radius", "widget": "number", "min": 0.02, "max": 1, "step": 0.005},
    "toyBall.profiles.*.massKg": {"label": "Mass (kg)", "description": "Changes flick effort and air resistance, not gravity.", "widget": "number", "min": 0.001, "max": 20, "step": 0.001},
    "toyBall.balloon.colorModels.*": {"label": "Balloon color model", "widget": "asset", "group": "toys"},
    "toyBall.profiles.*.bounce": {"label": "Bounce restitution", "widget": "number", "min": 0, "max": 0.95, "step": 0.01},
    "toyBall.profiles.*.groundDrag": {"label": "Rolling and impact friction", "widget": "number", "min": 0.1, "max": 20, "step": 0.1},
    "toyBall.profiles.*.airDrag": {"label": "Air resistance", "widget": "number", "min": 0, "max": 5, "step": 0.001},
    "toyBall.profiles.*.throwGain": {"label": "Flick strength", "widget": "number", "min": 0.1, "max": 5, "step": 0.1},
    "toyBall.profiles.*.maxThrowSpeed": {"label": "Maximum throw speed", "widget": "number", "min": 1, "max": 40, "step": 0.5},
    "toyBall.profiles.*.releaseLift": {"label": "Upward release impulse", "widget": "number", "min": 0, "max": 5, "step": 0.1},
    "toyBall.profiles.*.gravity": {"label": "Gravity", "widget": "number", "min": 0.1, "max": 50, "step": 0.1}
  },
