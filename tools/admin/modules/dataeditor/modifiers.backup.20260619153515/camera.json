{
  "title": "Camera Settings",
  "description": "Camera distances, offsets, zoom, and angle tuning.",
  "tags": [
    "camera",
    "template"
  ],
  "groups": [
    {
      "id": "position",
      "label": "Position and follow",
      "order": 10
    },
    {
      "id": "lens",
      "label": "Lens",
      "order": 20
    },
    {
      "id": "limits",
      "label": "Limits",
      "order": 30
    }
  ],
  "patterns": {
    "*.x": {
      "widget": "number",
      "step": 0.05,
      "group": "position"
    },
    "*.y": {
      "widget": "number",
      "step": 0.05,
      "group": "position"
    },
    "*.z": {
      "widget": "number",
      "step": 0.05,
      "group": "position"
    },
    "*.zoom": {
      "widget": "slider",
      "min": 0.1,
      "max": 8,
      "step": 0.05,
      "group": "lens"
    },
    "*.fov": {
      "widget": "slider",
      "min": 15,
      "max": 120,
      "step": 1,
      "unit": "\u00b0",
      "group": "lens"
    },
    "*.yaw": {
      "widget": "knob",
      "min": 0,
      "max": 360,
      "step": 1,
      "unit": "\u00b0",
      "group": "position"
    },
    "*.pitch": {
      "widget": "slider",
      "min": -89,
      "max": 89,
      "step": 1,
      "unit": "\u00b0",
      "group": "position"
    },
    "*.min_*": {
      "widget": "number",
      "group": "limits",
      "advanced": true
    },
    "*.max_*": {
      "widget": "number",
      "group": "limits",
      "advanced": true
    }
  }
}
