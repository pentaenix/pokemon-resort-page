#!/usr/bin/env bash
set -euo pipefail
CMD="${1:-run}"
ROOT="$(cd "$(dirname "$0")" && pwd)"
export SPMK_ROOT="$ROOT"
PYTHON_BIN="${PYTHON:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  if [[ -x "$ROOT/.venv/bin/python" ]]; then
    PYTHON_BIN="$ROOT/.venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
  elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
  else
    echo "Character editor needs Python 3.10+. On macOS: brew install python"
    exit 1
  fi
fi
PORT="${CHARACTER_EDITOR_PORT:-8789}"
if [[ "$CMD" == "run" ]]; then
  "$PYTHON_BIN" -m spmk_app.server --host 127.0.0.1 --port "$PORT"
else
  echo "Usage: ./charactereditor run"
  exit 1
fi
